/wp-content/themes/twentytwentytwo/
/wp-content/themes/twentytwentythree/
/wp-content/themes/twentytwentyfour/
/wp-content/themes/twentytwentyfive/

# Only the custom theme(s)/plugin(s) we build should be tracked under
# /wp-content/themes/ and /wp-content/plugins/ — third-party plugins
# installed from wp.org/Elementor marketplace are excluded once added:
# /wp-content/plugins/*
# !/wp-content/plugins/my-custom-plugin/

