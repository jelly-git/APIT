# WordPress core - not versioned, managed via WP-CLI/updates
/wp-admin/
/wp-includes/
/wp-*.php
index.php
license.txt
readme.html
xmlrpc.php
local-xdebuginfo.php

# Config & secrets
wp-config.php
.htaccess

# Uploads & generated content
/wp-content/uploads/
/wp-content/upgrade/
/wp-content/cache/
/wp-content/backup*/
/wp-content/backups/
/wp-content/languages/

# Third-party themes/plugins (WordPress core defaults, Elementor, etc.)
# are reinstalled via WP-CLI, not versioned. Only our own child
# theme/plugin is tracked (add an exception below once it exists), e.g.:
# !/wp-content/themes/apit-child/
/wp-content/themes/*
/wp-content/plugins/*
!/wp-content/plugins/index.php
!/wp-content/themes/index.php

# Local by Flywheel
.ddev/
local-xdebuginfo.php

# OS / editor cruft
.DS_Store
Thumbs.db
.vscode/
.idea/

# Node / build tooling
node_modules/
npm-debug.log
